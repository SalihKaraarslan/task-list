# The only value you must set: your MongoDB connection string.
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tasklist?retryWrites=true&w=majority&appName=task-list
# Local:  mongodb://127.0.0.1:27017/tasklist
MONGODB_URI=

# Optional. Keep 4000: the mobile app looks for the backend on this port.
PORT=4000
